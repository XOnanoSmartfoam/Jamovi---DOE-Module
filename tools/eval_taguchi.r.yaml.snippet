    - name: analysisInfo
      title: Taguchi Summary
      type: Html
      visible: (evaluateDesign)
      clearWith:
        - evaluateDesign
        - snType
        - factors
        - replicates
        - seed
        - nResponses
        - simulateResponses
        - useOuter
        - noiseFactors

    - name: analysisPerRun
      title: Per-run SN and Mean
      type: Table
      visible: (evaluateDesign)
      columns:
        - name: run
          title: Run
          type: integer
        - name: mean
          title: Mean
          type: number
        - name: sn
          title: SN
          type: number

    - name: analysisResponseSN
      title: Response Table (SN)
      type: Table
      visible: (evaluateDesign)
      columns:
        - name: factor
          title: Factor
          type: text
        - name: level
          title: Level
          type: text
        - name: meanSN
          title: Mean SN
          type: number

    - name: analysisResponseMean
      title: Response Table (Means)
      type: Table
      visible: (evaluateDesign)
      columns:
        - name: factor
          title: Factor
          type: text
        - name: level
          title: Level
          type: text
        - name: meanY
          title: Mean Response
          type: number

    - name: analysisSnAnova
      title: ANOVA on SN
      type: Table
      visible: (evaluateDesign && snModel)
      columns:
        - name: term
          title: Term
          type: text
        - name: ss
          title: Sum of Squares
          type: number
        - name: df
          title: df
          type: integer
        - name: ms
          title: Mean Square
          type: number
        - name: F
          title: F
          type: number
        - name: p
          title: p
          type: number
          format: zto,pvalue

    - name: analysisPlotSN
      title: SN Main Effects
      type: Image
      width: 500
      height: 400
      renderFun: .plotSN
      visible: (evaluateDesign && plotSN)

    - name: analysisPlotMeans
      title: Means Main Effects
      type: Image
      width: 500
      height: 400
      renderFun: .plotMeans
      visible: (evaluateDesign && plotMeans)
